# Copy to .env and fill in. .env is gitignored; never commit real values.
# This file lists only what the local environment (P0-U2) uses; P0-U3 expands it.

# Monad mainnet RPC, used only as the upstream for the local anvil fork.
MONAD_RPC_URL=https://your-monad-rpc.example/your-api-key

# Optional overrides for the local Docker services (development only).
# POSTGRES_PORT=5432
# POSTGRES_PASSWORD=alpha_local_dev_only
# REDIS_PORT=6380
