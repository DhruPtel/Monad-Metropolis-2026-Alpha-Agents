# The public HTTPS address of the testnet control API (docs/HOSTING.md). Caddy gets and renews
# the certificate itself; sslip.io resolves api.161.35.99.236.sslip.io to this server.
api.161.35.99.236.sslip.io {
	encode gzip
	# Only the guard is reachable: it forwards /health and /v1/* to the control API with CORS for
	# the Vercel site and per-client rate limits (scripts/host-tunnel.js guard).
	reverse_proxy app-net:4190 {
		# The guard keys its rate limits on these; a client must not set them itself.
		header_up -Cf-Connecting-Ip
		header_up X-Forwarded-For {remote_host}
	}
	log {
		output stdout
		format console
	}
}
