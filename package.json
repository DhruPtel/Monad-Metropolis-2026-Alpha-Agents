{
  "name": "alpha-agents",
  "version": "0.0.0",
  "private": true,
  "description": "Alpha Agents: an onchain financial management platform on Monad where AI agents are NFTs.",
  "type": "module",
  "packageManager": "pnpm@9.14.4",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=9 <10"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "test": "vitest run",
    "doctor": "node scripts/doctor.js",
    "dev:up": "node scripts/dev.js up",
    "dev:status": "node scripts/dev.js status",
    "dev:down": "node scripts/dev.js down",
    "dev:reset": "node scripts/dev.js reset",
    "db:migrate": "node scripts/db.js migrate",
    "db:reset": "node scripts/db.js reset",
    "allowlist": "node scripts/allowlist.js",
    "test:fork": "node scripts/test-fork.js",
    "env:example": "node scripts/env-example.js",
    "secrets:scan": "node scripts/secrets-scan.js",
    "dev:web": "node scripts/web.js dev",
    "dev:indexer": "node services/indexer/src/main.ts",
    "dev:api": "node apps/control-api/src/main.ts",
    "dev:orchestrator": "node services/orchestrator/src/main.ts",
    "dev:litellm": "docker compose -f infra/compose.yaml --env-file .env --profile agent up -d --wait litellm",
    "test:web:e2e": "node scripts/web-e2e.js",
    "test:web:live": "node scripts/web-e2e.js --app web --live",
    "test:web:live:agents": "node scripts/web-e2e.js --app web --live --agents",
    "test:orchestrator:live": "node services/orchestrator/src/live.ts",
    "dev:console": "node scripts/console.js dev",
    "dev:all": "node scripts/dev-all.js",
    "test:console:e2e": "node scripts/web-e2e.js --app console",
    "test:console:live": "node scripts/web-e2e.js --app console --live",
    "spike:hermes:local": "node services/orchestrator/src/spike/local-smoke.ts",
    "spike:hermes:template": "node services/orchestrator/src/spike/build-template.ts",
    "spike:hermes": "node services/orchestrator/src/spike/run-spike.ts",
    "spike:venues": "node scripts/spikes/p2-u0/run.ts",
    "deploy:agent-nft": "node scripts/deploy-agent-nft.js",
    "agent-nft:local": "node scripts/agent-nft-local.js",
    "assets:build-bee": "node scripts/assets/build-bee-model.ts",
    "assets:check": "node scripts/assets/check-models.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/node": "^22",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "meshoptimizer": "1.3.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "viem": "2.57.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@alpha-agents/config": "workspace:^",
    "@alpha-agents/db": "workspace:^",
    "@alpha-agents/devenv": "workspace:^",
    "@alpha-agents/domain": "workspace:^"
  }
}
